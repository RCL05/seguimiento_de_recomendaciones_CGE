# Copiar a frontend/.env.local y reiniciar Vite después de editar.
# Las rutas del cliente ya incluyen /api/v1: no añadir ese prefijo aquí.
# Vacío: solicitudes al mismo origen, redirigidas por el proxy en desarrollo.
VITE_API_BASE=

# Backend local. Docker Compose inyecta http://backend:8000 y tiene prioridad.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Para acceder directamente al backend desde el navegador, usar por ejemplo:
# VITE_API_BASE=http://localhost:8000
# Django debe permitir el origen del frontend en DJANGO_CORS_ALLOWED_ORIGINS.
# VITE_API_BASE se incorpora durante el build; reconstruir al cambiar de entorno.
