<?xml version="1.0" encoding="UTF-8"?>
<!-- P1 Registro de informe y asignación de recomendaciones — SITRA-CGE UNL. Fuente editable BPMN 2.0 (abrir con bpmn.io o Camunda Modeler). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Defs_P1_RegistroAsignacion" targetNamespace="https://github.com/RCL05/seguimiento_de_recomendaciones_CGE/bpmn">
  <bpmn:collaboration id="Collab_P1_RegistroAsignacion">
    <bpmn:participant id="Pool_P1_RegistroAsignacion" name="SITRA-CGE UNL" processRef="P1_RegistroAsignacion" />
  </bpmn:collaboration>
  <bpmn:process id="P1_RegistroAsignacion" name="P1 Registro de informe y asignación de recomendaciones" isExecutable="false">
  <bpmn:laneSet id="LaneSet_P1_RegistroAsignacion">
    <bpmn:lane id="Lane_P1_RegistroAsignacion_0" name="UAI">
      <bpmn:flowNodeRef>P1_S</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_T1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_T3</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_P1_RegistroAsignacion_1" name="Sistema SITRA-CGE">
      <bpmn:flowNodeRef>P1_T2</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_G1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_E1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_T4</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_G2</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P1_E2</bpmn:flowNodeRef>
    </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="P1_S" name="Informe CGE recibido">
    <bpmn:outgoing>P1_F1</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="P1_T1" name="Registrar informe (número, período, fecha, PDF o URL)">
    <bpmn:incoming>P1_F1</bpmn:incoming>
    <bpmn:outgoing>P1_F2</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="P1_T2" name="Validar datos y unicidad del número">
    <bpmn:incoming>P1_F2</bpmn:incoming>
    <bpmn:outgoing>P1_F3</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="P1_G1" name="¿Informe válido?">
    <bpmn:incoming>P1_F3</bpmn:incoming>
    <bpmn:outgoing>P1_F4</bpmn:outgoing>
    <bpmn:outgoing>P1_F5</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:endEvent id="P1_E1" name="Rechazo 400 / 409">
    <bpmn:incoming>P1_F4</bpmn:incoming>
    <bpmn:errorEventDefinition id="ErrDef_P1_E1" />
  </bpmn:endEvent>
  <bpmn:task id="P1_T3" name="Registrar recomendación (unidad, plazo, prioridad)">
    <bpmn:incoming>P1_F5</bpmn:incoming>
    <bpmn:incoming>P1_F9</bpmn:incoming>
    <bpmn:outgoing>P1_F6</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="P1_T4" name="Validar campos y unicidad por informe; auditar">
    <bpmn:incoming>P1_F6</bpmn:incoming>
    <bpmn:outgoing>P1_F7</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="P1_G2" name="¿Recomendación válida?">
    <bpmn:incoming>P1_F7</bpmn:incoming>
    <bpmn:outgoing>P1_F8</bpmn:outgoing>
    <bpmn:outgoing>P1_F9</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:endEvent id="P1_E2" name="Recomendación en PENDIENTE">
    <bpmn:incoming>P1_F8</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="P1_F1" sourceRef="P1_S" targetRef="P1_T1" />
  <bpmn:sequenceFlow id="P1_F2" sourceRef="P1_T1" targetRef="P1_T2" />
  <bpmn:sequenceFlow id="P1_F3" sourceRef="P1_T2" targetRef="P1_G1" />
  <bpmn:sequenceFlow id="P1_F4" sourceRef="P1_G1" targetRef="P1_E1" name="No" />
  <bpmn:sequenceFlow id="P1_F5" sourceRef="P1_G1" targetRef="P1_T3" name="Sí" />
  <bpmn:sequenceFlow id="P1_F6" sourceRef="P1_T3" targetRef="P1_T4" />
  <bpmn:sequenceFlow id="P1_F7" sourceRef="P1_T4" targetRef="P1_G2" />
  <bpmn:sequenceFlow id="P1_F8" sourceRef="P1_G2" targetRef="P1_E2" name="Sí" />
  <bpmn:sequenceFlow id="P1_F9" sourceRef="P1_G2" targetRef="P1_T3" name="No: corregir" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P1_RegistroAsignacion">
    <bpmndi:BPMNPlane id="Plane_P1_RegistroAsignacion" bpmnElement="Collab_P1_RegistroAsignacion">
      <bpmndi:BPMNShape id="Pool_P1_RegistroAsignacion_di" bpmnElement="Pool_P1_RegistroAsignacion" isHorizontal="true"><dc:Bounds x="120" y="80" width="1420" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_RegistroAsignacion_0_di" bpmnElement="Lane_P1_RegistroAsignacion_0" isHorizontal="true"><dc:Bounds x="150" y="80" width="1390" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_RegistroAsignacion_1_di" bpmnElement="Lane_P1_RegistroAsignacion_1" isHorizontal="true"><dc:Bounds x="150" y="250" width="1390" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_S_di" bpmnElement="P1_S"><dc:Bounds x="244" y="147" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_T1_di" bpmnElement="P1_T1"><dc:Bounds x="368" y="125" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_T2_di" bpmnElement="P1_T2"><dc:Bounds x="532" y="295" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_G1_di" bpmnElement="P1_G1" isMarkerVisible="true"><dc:Bounds x="732" y="310" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_E1_di" bpmnElement="P1_E1"><dc:Bounds x="904" y="317" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_T3_di" bpmnElement="P1_T3"><dc:Bounds x="862" y="125" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_T4_di" bpmnElement="P1_T4"><dc:Bounds x="1028" y="295" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_G2_di" bpmnElement="P1_G2" isMarkerVisible="true"><dc:Bounds x="1228" y="310" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_E2_di" bpmnElement="P1_E2"><dc:Bounds x="1400" y="317" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_F1_di" bpmnElement="P1_F1"><di:waypoint x="280" y="165" /><di:waypoint x="368" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F2_di" bpmnElement="P1_F2"><di:waypoint x="488" y="165" /><di:waypoint x="510" y="165" /><di:waypoint x="510" y="335" /><di:waypoint x="532" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F3_di" bpmnElement="P1_F3"><di:waypoint x="652" y="335" /><di:waypoint x="732" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F4_di" bpmnElement="P1_F4"><di:waypoint x="782" y="335" /><di:waypoint x="904" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F5_di" bpmnElement="P1_F5"><di:waypoint x="782" y="335" /><di:waypoint x="822" y="335" /><di:waypoint x="822" y="165" /><di:waypoint x="862" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F6_di" bpmnElement="P1_F6"><di:waypoint x="982" y="165" /><di:waypoint x="1005" y="165" /><di:waypoint x="1005" y="335" /><di:waypoint x="1028" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F7_di" bpmnElement="P1_F7"><di:waypoint x="1148" y="335" /><di:waypoint x="1228" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F8_di" bpmnElement="P1_F8"><di:waypoint x="1278" y="335" /><di:waypoint x="1400" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F9_di" bpmnElement="P1_F9"><di:waypoint x="1252" y="360" /><di:waypoint x="1252" y="408" /><di:waypoint x="922" y="408" /><di:waypoint x="922" y="205" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
