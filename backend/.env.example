APP_ENV=development
MAX_PDF_SIZE_BYTES=31457280

# Django
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes web autorizados para CORS (separados por comas). Vacío en DEBUG = Vite local.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
DJANGO_MEDIA_ROOT=./media

# Base de datos (dejar POSTGRES_DB vacío para usar SQLite en desarrollo)
POSTGRES_DB=
POSTGRES_USER=sitra_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SSO institucional
SSO_ISSUER=https://sso.unl.edu.ec
SSO_INTROSPECTION_URL=
SSO_CLIENT_ID=sitra-cge
SSO_CLIENT_SECRET=change-me
SSO_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# SMTP institucional (si EMAIL_HOST queda vacío, en DEBUG se imprime en consola)
EMAIL_HOST=smtp.unl.edu.ec
EMAIL_PORT=587
EMAIL_HOST_USER=notificaciones@unl.edu.ec
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
# Opcional: forzar backend (smtp, console, locmem) sin cambiar el resto de variables.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=SITRA-CGE <no-reply@unl.edu.ec>

# Job programado de plazos (servicio `scheduler` de docker-compose)
SCHEDULER_INTERVAL_SECONDS=3600

# Almacenamiento de evidencias
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_ACCESS_KEY=
EVIDENCE_S3_SECRET_KEY=

# Frontend
VITE_API_BASE=
